/* Include this file before the generated FSP linker script for the
 * standalone RA8D1 secure bootloader project. */
RAM_START = 0x22000000;
RAM_LENGTH = 0x000E0000;
FLASH_START = 0x02000000;
FLASH_LENGTH = 0x00010000;
DATA_FLASH_START = 0x27000000;
DATA_FLASH_LENGTH = 0x00000400;
SDRAM_START = 0x68000000;
SDRAM_LENGTH = 0x08000000;
